{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "firmware/**",
      "figma/**",
      "server.py",
      "scan_wifi.py",
      "generate_png_icons.py",
      "esp32_ip.txt",
      "*.py",
      "*.txt",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
